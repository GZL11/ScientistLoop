{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "default_agent": "famou-single",
  "agent": {
    "famou-single": {
      "thinking": { "type": "adaptive" },
      "reasoningEffort": "high",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "write": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "task": "deny"
      }
    }
  }
}
