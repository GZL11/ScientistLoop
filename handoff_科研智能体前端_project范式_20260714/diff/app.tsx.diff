+// 文献引用联动：把正文里的 [n] 变成可点上标 sup.cite-num（点击→跳右栏对应文献）。
+// 自包含 rehype 插件（无外部依赖）；只在下面 TextBlock 里用，不影响 PaperFocus/工作区 md 渲染。
+function rehypeCiteNum() {
+  const SKIP = new Set(["code", "a", "sup", "pre"])
+  function walk(node, parent) {
+    if (!node) return
+    if (node.type === "element" && SKIP.has(node.tagName)) return
+    if (node.type === "text" && parent && /\[\d+\]/.test(node.value)) {
+      const parts = []
+      let last = 0, m
+      const re = /\[(\d+)\]/g
+      while ((m = re.exec(node.value))) {
+        if (m.index > last) parts.push({ type: "text", value: node.value.slice(last, m.index) })
+        parts.push({
+          type: "element", tagName: "sup",
+          properties: { className: ["cite-num"], "data-cite": m[1] },
+          children: [{ type: "text", value: m[1] }],
+        })
+        last = m.index + m[0].length
+      }
+      if (last < node.value.length) parts.push({ type: "text", value: node.value.slice(last) })
+      const i = parent.children.indexOf(node)
+      if (i >= 0) parent.children.splice(i, 1, ...parts)
+      return
+    }
+    if (node.children) for (const c of [...node.children]) walk(c, node)
+  }
+  return (tree) => walk(tree, null)
+}
